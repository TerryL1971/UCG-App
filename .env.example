# Copy to .env and fill in real values. Never commit .env itself — it's
# already in .gitignore. See docs/backend-and-ai-agent-plan.md ("Open
# questions") for who's actually supposed to own/fund each of these keys.

# Claude API key for the in-app AI agent chat (src/app/api/chat+api.ts).
# Without this set, the chat screen degrades gracefully to a "not
# connected yet" message instead of crashing — see chat+api.ts. Decision
# (Sept 2): this belongs to UCG, set up when David/Michelle/James are
# ready to own it — not fronted by Terry personally.
ANTHROPIC_API_KEY=

# PayPal REST API app credentials for the deposit flow
# (src/app/api/paypal/create-order+api.ts, capture-order+api.ts).
# Get these from a PayPal Developer app at developer.paypal.com/dashboard.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Defaults to the Sandbox host if unset — see src/lib/paypal-server.ts.
# Going live is this one line, PLUS swapping the two credentials above to
# a verified PayPal Business account's LIVE app credentials (sandbox
# credentials do not work against the live host, and vice versa).
# PAYPAL_API_BASE=https://api-m.paypal.com
