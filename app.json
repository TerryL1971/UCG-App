{
  "expo": {
    "name": "Used Car Guys",
    "slug": "used-car-guys",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ucg",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "net.usedcarguys.app"
    },
    "android": {
      "package": "net.usedcarguys.app",
      "adaptiveIcon": {
        "backgroundColor": "#273368",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#273368",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used Car Guys uses your camera to scan a VIN barcode and take photos of your car.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used Car Guys uses your photo library so you can attach existing photos of your car.",
          "cameraPermission": "Used Car Guys uses your camera to scan a VIN barcode and take photos of your car.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
